# Independent, root-owned group configuration. All values are fictitious.
RESTIC_REPOSITORY=/mnt/backup/restic

# Share this file explicitly, or use the group's own repository-password file.
# Credentials are never copied from the legacy configuration.
RESTIC_PASSWORD_FILE=/etc/pw-backup/repository-password
PW_BACKUP_HOST=example-host

# PW_BACKUP_TAG must not be set: the tag is pw-backup-group-documents.
# Cache defaults to /var/cache/pw-backup/groups/documents.
PW_BACKUP_SKIP_IF_UNCHANGED=true
PW_BACKUP_RETENTION_ENABLED=false
PW_BACKUP_KEEP_LAST=7

# Designate just one enabled maintenance configuration per shared repository.
PW_BACKUP_PRUNE=false
