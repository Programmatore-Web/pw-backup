# PW Backup configuration
#
# This file is loaded by /usr/local/sbin/pw-backup as a root-owned shell-style
# environment file. Keep it owned by root and not writable by group or others.

# Required: any repository supported by Restic.
# Examples:
# RESTIC_REPOSITORY=/mnt/backup/restic
# RESTIC_REPOSITORY=sftp:backup@backup.example.net:/repositories/server01
# RESTIC_REPOSITORY=rest:https://backup.example.net/server01
# RESTIC_REPOSITORY=s3:https://objects.example.net/example-bucket/server01
RESTIC_REPOSITORY=

RESTIC_PASSWORD_FILE=/etc/pw-backup/repository-password
RESTIC_CACHE_DIR=/var/cache/pw-backup/restic

# Optional snapshot metadata.
PW_BACKUP_TAG=pw-backup
PW_BACKUP_HOST=

# Do not create a new snapshot when the selected content is unchanged.
PW_BACKUP_SKIP_IF_UNCHANGED=true

# Optional repository maintenance. These settings are local to this machine,
# so each host can use a different policy and can change it over time.
PW_BACKUP_RETENTION_ENABLED=false
PW_BACKUP_KEEP_LAST=
PW_BACKUP_KEEP_HOURLY=
PW_BACKUP_KEEP_DAILY=
PW_BACKUP_KEEP_WEEKLY=
PW_BACKUP_KEEP_MONTHLY=
PW_BACKUP_KEEP_YEARLY=

# true: forget removes snapshots and prune reclaims unreferenced repository data.
# false: forget applies the retention policy without reclaiming space yet.
PW_BACKUP_PRUNE=false

# Backend-specific environment variables may be added below when required.
# Keep all example values fictitious.
# AWS_ACCESS_KEY_ID=example-access-key
# AWS_SECRET_ACCESS_KEY=example-secret-key
