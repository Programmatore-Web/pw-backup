[Unit]
Description=PW Backup Restic repository maintenance
Documentation=https://github.com/Programmatore-Web/pw-backup
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/pw-backup/config.env

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pw-backup maintenance
User=root
Group=root
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=infinity
