#!/bin/sh
set -eu

PROGRAM_NAME='pw-backup'
PROGRAM_VERSION='0.3.0-rc.1'
DEFAULT_CONFIG_DIR='/etc/pw-backup'
CONFIG_ROOT=${PW_BACKUP_CONFIG_DIR:-$DEFAULT_CONFIG_DIR}
LOCK_DIR='/run/pw-backup'
PENDING_DIR='/var/lib/pw-backup/pending'
email_to=''
email_host=unavailable
email_group=''
email_operation=''
email_issue=operation-failed
email_state=''

log() { printf '%s: %s\n' "$PROGRAM_NAME" "$*"; }
fail() { printf '%s: error: %s\n' "$PROGRAM_NAME" "$*" >&2; exit 1; }

valid_recipient() {
    [ -n "$1" ] || return 0
    [ "${#1}" -le 254 ] || return 1
    case "$1" in *[!a-zA-Z0-9._%+@-]*) return 1 ;; esac
    printf '%s\n' "$1" | LC_ALL=C grep -Eq '^[A-Za-z0-9][A-Za-z0-9._%+-]*@[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$'
}

safe_email_host() {
    case "$1" in ''|*[!a-zA-Z0-9._-]*) printf '%s' unavailable; return ;; esac
    if [ "${#1}" -le 255 ]; then printf '%s' "$1"; else printf '%s' unavailable; fi
}

prepare_email() {
    email_operation=$1
    email_to=''
    email_host=unavailable
    email_group=''
    email_state=''
    email_issue=operation-failed
    operation_status=0
    trap 'operation_status=$?; notify_result "$operation_status" || :' EXIT
}

# Best effort, once per invocation. Never use command output or logs as mail text.
notify_result() (
    trap - EXIT
    trap '' HUP INT TERM
    email_code=$1
    if [ "$email_code" -eq 0 ]; then
        [ -z "$email_to" ] || log "INFO: $email_operation completed" >&2
        return 0
    fi
    case "$email_issue" in
        lock-timeout) email_level=WARNING; email_description='Operation skipped because the shared local lock was unavailable.' ;;
        pre-failed) email_level=CRITICAL; email_description='PRE hook failed; backup was not started.' ;;
        post-failed) email_level=CRITICAL; email_description='POST cleanup failed; recovery remains pending.' ;;
        pre-post-failed) email_level=CRITICAL; email_description='PRE hook and POST cleanup failed; recovery remains pending.' ;;
        restic-post-failed) email_level=CRITICAL; email_description='Restic and POST cleanup failed; recovery remains pending.' ;;
        restic-failed) email_level=CRITICAL; email_description='Restic failed or returned an incomplete result.' ;;
        recovery-failed) email_level=CRITICAL; email_description='Pending cleanup could not be completed; state preserved.' ;;
        interrupted) email_level=CRITICAL; email_description='Operation was interrupted.' ;;
        *) email_level=CRITICAL; email_description='Operation failed before completion.' ;;
    esac
    log "$email_level: $email_description (exit code $email_code)" >&2
    [ -n "$email_to" ] || return 0
    valid_recipient "$email_to" || { log 'WARNING: email recipient is unavailable' >&2; return 0; }
    # A successful submission for this cleanup obligation suppresses a repeated
    # alert from ExecStopPost/recover. This is neither a queue nor a delivery log.
    if [ -n "$email_state" ] && [ -e "$email_state/notified" ]; then
        if (check_secure_path "$email_state/notified"; [ -f "$email_state/notified" ] &&
            [ ! -s "$email_state/notified" ] && [ "$(stat -c '%a' "$email_state/notified")" = 600 ]); then
            return 0
        fi
    fi
    email_command=$(command -v sendmail) || { log 'WARNING: sendmail is unavailable; email was not submitted' >&2; return 0; }
    message_operation=$email_operation
    case "$message_operation" in backup|maintenance|prune|recovery) ;; *) message_operation=operation ;; esac
    message_group=$email_group
    case "$message_group" in
        '') message_group=legacy ;;
        [!a-z0-9]*|*[!a-z0-9_-]*) message_group=unavailable ;;
    esac
    [ "${#message_group}" -le 64 ] || message_group=unavailable
    message_host=$(safe_email_host "$email_host")
    case "$email_code" in ''|*[!0-9]*) email_code=1 ;; esac
    [ "${#email_code}" -le 3 ] || email_code=1
    email_time=$(date -u '+%Y-%m-%dT%H:%M:%SZ') || {
        log 'WARNING: could not prepare email timestamp; original result preserved' >&2
        return 0
    }
    email_status=0
    {
        printf 'To: %s\nSubject: [pw-backup] %s %s\n' "$email_to" "$email_level" "$message_operation"
        printf 'Auto-Submitted: auto-generated\nContent-Type: text/plain; charset=UTF-8\n\n'
        printf 'Severity: %s\nOperation: %s\nGroup: %s\nHost: %s\nUTC: %s\n' \
            "$email_level" "$message_operation" "$message_group" "$message_host" "$email_time"
        printf 'Result: failed\nExit code: %s\n%s\n' "$email_code" "$email_description"
    } | timeout --kill-after=5s 30s env --default-signal=HUP,INT,TERM -i \
        PATH=/usr/sbin:/usr/bin:/sbin:/bin "$email_command" -t -i 9>&- >/dev/null 2>&1 || email_status=$?
    if [ "$email_status" -ne 0 ]; then
        log "WARNING: sendmail submission failed (exit code $email_status); original result preserved" >&2
    elif [ -n "$email_state" ] && [ -f "$email_state/record" ]; then
        (check_secure_path "$email_state"; umask 077; set -C
            : > "$email_state/notified" && sync -f "$email_state") ||
            log 'WARNING: could not record email submission; a later alert may repeat' >&2
    fi
    return 0
)

notify_lock_failure() (
    trap - EXIT
    case "$email_operation" in
        backup) set -- "$selected_group" ;;
        maintenance)
            email_scopes=$(configured_groups) || exit 0
            # Identifiers have already been validated; split the group list.
            # shellcheck disable=SC2086
            set -- '' $email_scopes
            ;;
        recovery) [ -n "${selected_group:-}" ] || exit 0; set -- "$selected_group" ;;
        *) exit 0 ;;
    esac
    # Maintenance may affect several scopes; each lookup has its own context.
    for email_scope do
        (
            # Extra validation for this exceptional lookup, including legacy.
            if [ -z "$email_scope" ]; then
                check_secure_path "${PW_BACKUP_CONFIG_FILE:-$CONFIG_ROOT/config.env}"
            fi
            load_config "$email_scope"
            if [ "$email_operation" = maintenance ] && ! is_true "$PW_BACKUP_RETENTION_ENABLED"; then exit 0; fi
            email_issue=lock-timeout
            notify_result 1 || :
        ) || log 'WARNING: lock notification recipient could not be read safely' >&2
    done
)

show_help() {
    cat <<'HELP'
Usage:
  pw-backup run [--group <name>]
  pw-backup maintenance [--dry-run]
  pw-backup check-config [--group <name>]
  pw-backup restic [--group <name>] <arguments...>
  pw-backup recover [--group <name>]
  pw-backup --version
  pw-backup --help

Commands:
  run          Run only the configured Restic backup.
  maintenance  Apply legacy and group retention and optional prune.
  check-config Validate backup and maintenance configuration.
  restic       Run Restic with the configured repository environment.
  recover      Complete pending group cleanup without starting backups.
HELP
}

validate_group() {
    case "$1" in
        ''|[!a-z0-9]*|*[!a-z0-9_-]*) fail "invalid group name: $1" ;;
    esac
    [ "${#1}" -le 64 ] || fail 'group names must not exceed 64 characters'
}

acquire_lock() {
    command -v flock >/dev/null 2>&1 || fail 'flock is not installed'
    [ ! -L "$LOCK_DIR" ] || fail "lock directory must not be a symlink: $LOCK_DIR"
    (umask 077; mkdir -p "$LOCK_DIR")
    [ "$(stat -c '%u' "$LOCK_DIR")" = 0 ] || fail 'lock directory must be owned by root'
    chmod 0700 "$LOCK_DIR"
    [ ! -L "$LOCK_DIR/operation.lock" ] || fail 'lock file must not be a symlink'
    # Keep this descriptor open across all work, including Restic subprocesses.
    # Never unlink the file: every invocation must lock the same inode.
    umask 077
    exec 9>"$LOCK_DIR/operation.lock"
    log 'waiting for the shared local lock (timeout: 300s)' >&2
    flock -w 300 9 || {
        email_issue=lock-timeout
        notify_lock_failure
        fail 'timed out or failed acquiring the shared local lock after 300s'
    }
}

is_true() {
    case "$1" in
        1|true|TRUE|yes|YES|on|ON) return 0 ;;
        0|false|FALSE|no|NO|off|OFF) return 1 ;;
        *) fail "invalid boolean value: $1" ;;
    esac
}

validate_optional_count() {
    name=$1
    value=$2
    case "$value" in
        '') return 0 ;;
        *[!0-9]*) fail "$name must be empty or a non-negative integer" ;;
    esac
}

load_config() {
    email_to=''
    email_state=''
    GROUP_NAME=${1:-}
    if [ -n "$GROUP_NAME" ]; then
        validate_group "$GROUP_NAME"
        CONFIG_DIR="$CONFIG_ROOT/groups/$GROUP_NAME"
        CONFIG_FILE="$CONFIG_DIR/config.env"
        PATHS_FILE="$CONFIG_DIR/paths"
        EXCLUDES_FILE="$CONFIG_DIR/excludes"
        # Group configuration is self-contained, including when the caller has
        # exported legacy settings. Maintenance loads each scope in a subshell.
        unset RESTIC_REPOSITORY RESTIC_REPOSITORY_FILE RESTIC_PASSWORD_FILE \
            RESTIC_PASSWORD RESTIC_PASSWORD_COMMAND RESTIC_CACHE_DIR RESTIC_HOST \
            PW_BACKUP_TAG PW_BACKUP_HOST PW_BACKUP_SKIP_IF_UNCHANGED \
            PW_BACKUP_RETENTION_ENABLED PW_BACKUP_KEEP_LAST PW_BACKUP_KEEP_HOURLY \
            PW_BACKUP_KEEP_DAILY PW_BACKUP_KEEP_WEEKLY PW_BACKUP_KEEP_MONTHLY \
            PW_BACKUP_KEEP_YEARLY PW_BACKUP_PRUNE \
            PW_BACKUP_PRE_HOOK PW_BACKUP_POST_HOOK PW_BACKUP_EMAIL_TO
    else
        CONFIG_DIR=$CONFIG_ROOT
        CONFIG_FILE=${PW_BACKUP_CONFIG_FILE:-$CONFIG_DIR/config.env}
        PATHS_FILE=${PW_BACKUP_PATHS_FILE:-$CONFIG_DIR/paths}
        EXCLUDES_FILE=${PW_BACKUP_EXCLUDES_FILE:-$CONFIG_DIR/excludes}
    fi

    [ -r "$CONFIG_FILE" ] || fail "configuration file is not readable: $CONFIG_FILE"
    [ "$(stat -c '%u' "$CONFIG_FILE")" = '0' ] || fail "configuration file must be owned by root: $CONFIG_FILE"
    if find "$CONFIG_FILE" -perm /022 -print -quit | grep -q .; then
        fail "configuration file must not be writable by group or others: $CONFIG_FILE"
    fi
    if [ -n "$GROUP_NAME" ]; then
        group_config_path=$CONFIG_FILE
        case "$group_config_path" in
            /*) ;;
            *)
                config_working_dir=$(pwd -P)
                group_config_path="${config_working_dir%/}/$group_config_path"
                ;;
        esac
        check_secure_path "$group_config_path"
    fi

    # shellcheck source=/dev/null
    . "$CONFIG_FILE"

    if [ -n "$GROUP_NAME" ]; then
        [ "${PW_BACKUP_TAG+x}" != x ] || fail 'PW_BACKUP_TAG is generated for groups; remove it from the group configuration'
        PW_BACKUP_TAG="pw-backup-group-$GROUP_NAME"
        case "${PW_BACKUP_HOST:-}" in
            *[![:space:]]*) ;;
            *) fail "PW_BACKUP_HOST must be explicit and non-empty for group $GROUP_NAME" ;;
        esac
        : "${RESTIC_CACHE_DIR:=/var/cache/pw-backup/groups/$GROUP_NAME}"
        : "${PW_BACKUP_PRE_HOOK:=}"
        : "${PW_BACKUP_POST_HOOK:=}"
    fi
    : "${RESTIC_PASSWORD_FILE:=$CONFIG_DIR/repository-password}"
    : "${RESTIC_CACHE_DIR:=/var/cache/pw-backup/restic}"
    : "${PW_BACKUP_TAG:=pw-backup}"
    : "${PW_BACKUP_HOST:=}"
    : "${PW_BACKUP_SKIP_IF_UNCHANGED:=true}"
    : "${PW_BACKUP_RETENTION_ENABLED:=false}"
    : "${PW_BACKUP_KEEP_LAST:=}"
    : "${PW_BACKUP_KEEP_HOURLY:=}"
    : "${PW_BACKUP_KEEP_DAILY:=}"
    : "${PW_BACKUP_KEEP_WEEKLY:=}"
    : "${PW_BACKUP_KEEP_MONTHLY:=}"
    : "${PW_BACKUP_KEEP_YEARLY:=}"
    : "${PW_BACKUP_PRUNE:=false}"
    : "${PW_BACKUP_EMAIL_TO:=}"
    valid_recipient "$PW_BACKUP_EMAIL_TO" || fail 'PW_BACKUP_EMAIL_TO must be a single plain email address'
    email_to=$PW_BACKUP_EMAIL_TO
    email_group=$GROUP_NAME
    email_host=$(safe_email_host "$PW_BACKUP_HOST")

    export RESTIC_REPOSITORY RESTIC_PASSWORD_FILE RESTIC_CACHE_DIR
}

check_common_config() {
    command -v restic >/dev/null 2>&1 || fail 'Restic is not installed'
    [ -n "${RESTIC_REPOSITORY:-}" ] || fail 'RESTIC_REPOSITORY is empty'
    [ -r "$RESTIC_PASSWORD_FILE" ] || fail "password file is not readable: $RESTIC_PASSWORD_FILE"
    [ -s "$RESTIC_PASSWORD_FILE" ] || fail "password file is empty: $RESTIC_PASSWORD_FILE"
    mkdir -p "$RESTIC_CACHE_DIR"
    chmod 0700 "$RESTIC_CACHE_DIR"
}

check_maintenance_config() {
    is_true "$PW_BACKUP_RETENTION_ENABLED" >/dev/null || true
    is_true "$PW_BACKUP_PRUNE" >/dev/null || true
    validate_optional_count PW_BACKUP_KEEP_LAST "$PW_BACKUP_KEEP_LAST"
    validate_optional_count PW_BACKUP_KEEP_HOURLY "$PW_BACKUP_KEEP_HOURLY"
    validate_optional_count PW_BACKUP_KEEP_DAILY "$PW_BACKUP_KEEP_DAILY"
    validate_optional_count PW_BACKUP_KEEP_WEEKLY "$PW_BACKUP_KEEP_WEEKLY"
    validate_optional_count PW_BACKUP_KEEP_MONTHLY "$PW_BACKUP_KEEP_MONTHLY"
    validate_optional_count PW_BACKUP_KEEP_YEARLY "$PW_BACKUP_KEEP_YEARLY"
    if is_true "$PW_BACKUP_RETENTION_ENABLED" &&
       [ -z "$PW_BACKUP_KEEP_LAST$PW_BACKUP_KEEP_HOURLY$PW_BACKUP_KEEP_DAILY$PW_BACKUP_KEEP_WEEKLY$PW_BACKUP_KEEP_MONTHLY$PW_BACKUP_KEEP_YEARLY" ]; then
        fail 'retention is enabled but no keep policy is configured'
    fi
}

check_backup_config() {
    check_common_config
    check_maintenance_config
    [ -r "$PATHS_FILE" ] || fail "paths file is not readable: $PATHS_FILE"
    grep -Eq '^[[:space:]]*[^#[:space:]]' "$PATHS_FILE" || fail "paths file does not contain any active source: $PATHS_FILE"
    if [ -e "$EXCLUDES_FILE" ] && [ ! -r "$EXCLUDES_FILE" ]; then
        fail "excludes file is not readable: $EXCLUDES_FILE"
    fi
    is_true "$PW_BACKUP_SKIP_IF_UNCHANGED" >/dev/null || true
    if [ -n "$GROUP_NAME" ]; then check_hook_config; fi
    if [ -z "$GROUP_NAME" ]; then
        # Restic accepts comma-separated tags; reserve every group-tag token.
        case ",$PW_BACKUP_TAG" in
            *,pw-backup-group-*)
                legacy_groups=$(configured_groups)
                [ -z "$legacy_groups" ] || fail 'legacy backups cannot use reserved group tags when groups exist'
                ;;
        esac
    fi
}

run_backup() {
    check_backup_config
    if [ -n "$GROUP_NAME" ]; then recover_selected_group "$GROUP_NAME"; fi
    set -- backup --files-from "$PATHS_FILE"
    [ ! -r "$EXCLUDES_FILE" ] || set -- "$@" --exclude-file "$EXCLUDES_FILE"
    [ -z "$PW_BACKUP_TAG" ] || set -- "$@" --tag "$PW_BACKUP_TAG"
    [ -z "$PW_BACKUP_HOST" ] || set -- "$@" --host "$PW_BACKUP_HOST"
    [ -z "$GROUP_NAME" ] || set -- "$@" --group-by host,paths,tags
    if is_true "$PW_BACKUP_SKIP_IF_UNCHANGED"; then set -- "$@" --skip-if-unchanged; fi
    log 'starting Restic backup'
    if [ -n "$GROUP_NAME" ] && [ -n "$PW_BACKUP_PRE_HOOK$PW_BACKUP_POST_HOOK" ]; then
        run_hook_backup "$@"
    fi
    if [ -n "$email_to" ]; then run_notified_restic "$@"; fi
    exec restic "$@"
}

# A sticky root-owned directory (for example /tmp) protects root-owned children
# against replacement too. Every component, not just the final file, is checked.
check_secure_path() {
    secure_path=$1
    case "$secure_path" in
        /*) ;;
        *) fail "path must be absolute: $secure_path" ;;
    esac
    case "$secure_path" in
        *'
'*|*"$(printf '\r')"*|*//*|*/./*|*/../*|*/.|*/..) fail 'unsafe path syntax' ;;
    esac
    [ -f "$secure_path" ] || [ -d "$secure_path" ] || fail "not a regular file or directory: $secure_path"
    while :; do
        [ ! -L "$secure_path" ] || fail "symlinks are not allowed: $secure_path"
        [ "$(stat -c '%u' "$secure_path")" = 0 ] || fail "path must be owned by root: $secure_path"
        path_writable=$(find "$secure_path" -maxdepth 0 -perm /022 -print) || fail "cannot inspect path permissions: $secure_path"
        if [ -n "$path_writable" ]; then
            path_sticky=$(find "$secure_path" -maxdepth 0 -perm -1000 -print) || fail "cannot inspect sticky directory: $secure_path"
            if [ ! -d "$secure_path" ] || [ -z "$path_sticky" ]; then
                fail "path is writable by group or others: $secure_path"
            fi
        fi
        [ "$secure_path" != / ] || break
        secure_path=${secure_path%/*}
        [ -n "$secure_path" ] || secure_path=/
    done
}

check_hook_script() {
    check_secure_path "$1"
    [ -f "$1" ] || fail "hook must be a regular file: $1"
    [ -x "$1" ] || fail "hook must be executable: $1"
}

check_hook_config() {
    [ -z "$PW_BACKUP_PRE_HOOK" ] || [ -n "$PW_BACKUP_POST_HOOK" ] || fail 'PRE requires an idempotent POST hook'
    [ -z "$PW_BACKUP_PRE_HOOK" ] || check_hook_script "$PW_BACKUP_PRE_HOOK"
    [ -z "$PW_BACKUP_POST_HOOK" ] || check_hook_script "$PW_BACKUP_POST_HOOK"
}

file_digest() {
    digest=$(sha256sum < "$1") || return 1
    printf '%s' "${digest%% *}"
}

state_context() {
    state_root=$(CDPATH='' cd -- "$CONFIG_ROOT" && pwd -P) || fail 'cannot resolve configuration root for recovery'
    case "$state_root" in *'
'*) fail 'configuration root must be a single line' ;; esac
    root_digest=$(printf '%s\n' "$state_root" | sha256sum)
    state_key="${root_digest%% *}-$1"
    state_path="$PENDING_DIR/$state_key"
}

create_pending_state() {
    state_context "$GROUP_NAME"
    for state_dir in /var/lib/pw-backup "$PENDING_DIR"; do
        [ ! -L "$state_dir" ] || fail 'recovery directory must not be a symlink'
        (umask 077; mkdir -p "$state_dir")
        check_secure_path "$state_dir"
    done
    chmod 0700 "$PENDING_DIR"
    # mkdir reserves the obligation atomically; even a partially written state
    # must block this group rather than be overwritten after a crash.
    (umask 077; mkdir "$state_path") || fail 'pending recovery already exists'
    state_post_hash=$(file_digest "$PW_BACKUP_POST_HOOK")
    state_config_hash=$(file_digest "$state_root/groups/$GROUP_NAME/config.env")
    (umask 077
        if [ -n "$email_to" ]; then state_version=2; else state_version=1; fi
        { printf '%s\n' "$state_version" "$state_root" "$GROUP_NAME" "$PW_BACKUP_POST_HOOK" \
            "$state_post_hash" "$state_config_hash"
            [ "$state_version" = 1 ] || printf '%s\n' "$email_to" "$email_host"
        } > "$state_path/record.tmp") || fail 'cannot write recovery state'
    sync -f "$state_path/record.tmp" || fail 'cannot persist recovery state'
    mv -T -- "$state_path/record.tmp" "$state_path/record" || fail 'cannot publish recovery state'
    sync -f "$PENDING_DIR" || fail 'cannot persist published recovery state'
    email_state=$state_path
}

read_pending_state() {
    check_secure_path "$PENDING_DIR"
    check_secure_path "$state_path"
    [ -d "$state_path" ] || fail 'pending recovery is not a directory'
    [ "$(stat -c '%a' "$PENDING_DIR")" = 700 ] || fail 'recovery directory must have mode 0700'
    [ "$(stat -c '%a' "$state_path")" = 700 ] || fail 'pending directory must have mode 0700'
    extra_state_entries=$(find "$state_path" -mindepth 1 -maxdepth 1 ! -name record ! -name notified -print) || fail 'cannot inspect recovery state'
    [ -z "$extra_state_entries" ] || fail 'incomplete or ambiguous recovery state'
    check_secure_path "$state_path/record"
    [ -f "$state_path/record" ] || fail 'missing recovery record'
    [ "$(stat -c '%a' "$state_path/record")" = 600 ] || fail 'recovery record must have mode 0600'
    exec 8<"$state_path/record"
    {
        IFS= read -r state_version && IFS= read -r state_root &&
        IFS= read -r state_group && IFS= read -r state_post &&
        IFS= read -r state_post_hash && IFS= read -r state_config_hash
    } <&8 || fail 'incomplete recovery record'
    state_email=''
    state_host=unavailable
    case "$state_version" in
        1) ;;
        2)
            { IFS= read -r state_email && IFS= read -r state_host; } <&8 || fail 'incomplete email recovery context'
            [ -n "$state_email" ] || fail 'empty recovery email recipient'
            valid_recipient "$state_email" || fail 'invalid recovery email recipient'
            [ "$(safe_email_host "$state_host")" = "$state_host" ] || fail 'invalid recovery email host'
            ;;
        *) fail 'unknown recovery state version' ;;
    esac
    extra_record_data=''
    if IFS= read -r extra_record_data <&8 || [ -n "$extra_record_data" ]; then fail 'extra data in recovery record'; fi
    exec 8<&-
    case "$state_post" in /*) ;; *) fail 'invalid recovery POST path' ;; esac
    case "$state_post_hash$state_config_hash" in *[!0-9a-f]*) fail 'invalid recovery checksum' ;; esac
    [ "${#state_post_hash}" -eq 64 ] || fail 'invalid recovery POST checksum'
    [ "${#state_config_hash}" -eq 64 ] || fail 'invalid recovery configuration checksum'
    validate_group "$state_group"
    root_digest=$(printf '%s\n' "$state_root" | sha256sum)
    [ "${state_path##*/}" = "${root_digest%% *}-$state_group" ] || fail 'recovery state identity mismatch'
    case "$state_root" in /*) ;; *) fail 'invalid recovery configuration root' ;; esac
    check_secure_path "$state_root/groups/$state_group/config.env"
    if [ "$state_version" = 2 ]; then
        email_to=$state_email
        email_host=$state_host
        email_group=$state_group
        email_state=$state_path
    fi
    [ "$(file_digest "$state_root/groups/$state_group/config.env")" = "$state_config_hash" ] || fail 'configuration changed while recovery was pending'
    check_hook_script "$state_post"
    [ "$(file_digest "$state_post")" = "$state_post_hash" ] || fail 'POST script changed while recovery was pending'
}

# Only hook-enabled backups need a waiting shell. Stages have their own process
# group, so cleanup never races a still-writing Restic child after a signal.
interrupt_stage() {
    interrupted=$1
    trap '' HUP INT TERM
    if [ -n "$active_pid" ]; then
        kill -TERM "-$active_pid" 2>/dev/null || kill -TERM "$active_pid" 2>/dev/null || true
        (
            exec 9>&-
            sleep 10
            kill -KILL "-$active_pid" 2>/dev/null || true
        ) &
        killer_pid=$!
        wait "$active_pid" 2>/dev/null || true
        kill -KILL "-$active_pid" 2>/dev/null || true
        kill "$killer_pid" 2>/dev/null || true
        wait "$killer_pid" 2>/dev/null || true
        active_pid=''
    fi
}

stage_traps() {
    active_pid=''
    interrupted=0
    trap 'interrupt_stage 129' HUP
    trap 'interrupt_stage 130' INT
    trap 'interrupt_stage 143' TERM
}

run_stage() {
    [ "$interrupted" -eq 0 ] || return "$interrupted"
    setsid env --default-signal=HUP,INT,TERM "$@" &
    active_pid=$!
    if [ "$interrupted" -ne 0 ]; then interrupt_stage "$interrupted"; return "$interrupted"; fi
    stage_status=0
    wait "$active_pid" || stage_status=$?
    active_pid=''
    [ "$interrupted" -eq 0 ] || return "$interrupted"
    return "$stage_status"
}

run_notified_restic() {
    email_issue=restic-failed
    stage_traps
    restic_status=0
    run_stage restic "$@" || restic_status=$?
    [ "$interrupted" -eq 0 ] || email_issue=interrupted
    exit "$restic_status"
}

call_hook() {
    hook_phase=$1
    hook_mode=$2
    hook_result=$3
    hook_script=$4
    log "running $hook_phase hook for $state_group ($hook_mode, backup=$hook_result)" >&2
    run_stage timeout --kill-after=10s 300s env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin \
        PW_BACKUP_CONFIG_DIR="$state_root" PW_BACKUP_GROUP="$state_group" \
        PW_BACKUP_HOOK_PHASE="$hook_phase" PW_BACKUP_HOOK_MODE="$hook_mode" \
        PW_BACKUP_BACKUP_STATUS="$hook_result" "$hook_script"
}

remove_pending_state() {
    rm -f -- "$state_path/notified" && rm -- "$state_path/record" && rmdir -- "$state_path" && sync -f "$PENDING_DIR"
}

recover_state() (
    prepare_email recovery
    email_issue=recovery-failed
    recovery_status=0
    trap 'recovery_status=$?; if [ "$recovery_status" -ne 0 ]; then log "CRITICAL: pending cleanup could not be completed: $state_path" >&2; fi; notify_result "$recovery_status" || :' EXIT
    read_pending_state
    stage_traps
    call_hook post recovery unknown "$state_post" || fail 'POST recovery failed; state preserved'
    remove_pending_state || fail 'cannot remove completed recovery state'
    log "recovery completed for $state_group" >&2
)

recover_selected_group() {
    [ -e "$PENDING_DIR" ] || [ -L "$PENDING_DIR" ] || return 0
    check_secure_path "$PENDING_DIR"
    state_context "$1"
    [ -e "$state_path" ] || [ -L "$state_path" ] || return 0
    selected_recovery_status=0
    recover_state || selected_recovery_status=$?
    # recover_state owns this alert, even if submission failed or no recipient
    # could be validated. Do not retry it in the enclosing backup EXIT trap.
    if [ "$selected_recovery_status" -ne 0 ]; then email_to=''; fi
    return "$selected_recovery_status"
}

finish_hook_backup() {
    original_status=$1
    trap - EXIT
    trap '' HUP INT TERM
    if [ "$interrupted" -ne 0 ]; then
        original_status=$interrupted
        backup_result=interrupted
        email_issue=interrupted
        log "backup interrupted with exit code $original_status" >&2
    fi
    # Recovery validates the original configuration and exact POST bytes even
    # on the normal path, but retains the known backup result for the hook.
    if (
        read_pending_state
        interrupted=0
        call_hook post normal "$backup_result" "$state_post" || exit 1
        remove_pending_state
    ); then
        :
    else
        log "CRITICAL: POST cleanup failed; pending state preserved (original exit code $original_status)" >&2
        [ "$original_status" -ne 0 ] || original_status=1
        case "$email_issue" in
            pre-failed) email_issue=pre-post-failed ;;
            restic-failed) email_issue=restic-post-failed ;;
            *) email_issue=post-failed ;;
        esac
    fi
    notify_result "$original_status" || :
    exit "$original_status"
}

run_hook_backup() {
    create_pending_state
    state_group=$GROUP_NAME
    backup_result=not-run
    stage_traps
    trap 'finish_hook_backup "$?"' EXIT
    if [ -n "$PW_BACKUP_PRE_HOOK" ]; then
        pre_status=0
        call_hook pre normal not-run "$PW_BACKUP_PRE_HOOK" || pre_status=$?
        if [ "$pre_status" -ne 0 ]; then
            email_issue=pre-failed
            log "PRE failed with exit code $pre_status; Restic was not started" >&2
            exit "$pre_status"
        fi
    fi
    backup_result=failed
    email_issue=restic-failed
    restic_status=0
    run_stage restic "$@" || restic_status=$?
    if [ "$restic_status" -eq 0 ]; then
        backup_result=success
        email_issue=operation-failed
    else
        log "Restic failed with exit code $restic_status" >&2
    fi
    exit "$restic_status"
}

run_recover() {
    # ExecStopPost must be a no-op without state, including during uninstall
    # while its caller already holds the machine-wide lock.
    [ -e "$PENDING_DIR" ] || [ -L "$PENDING_DIR" ] || return 0
    check_secure_path "$PENDING_DIR"
    [ -d "$PENDING_DIR" ] || fail 'recovery state directory is invalid'
    if [ -n "$1" ]; then
        state_context "$1"
        [ -e "$state_path" ] || [ -L "$state_path" ] || return 0
    else
        pending_entry=$(find "$PENDING_DIR" -mindepth 1 -maxdepth 1 -print -quit) || fail 'CRITICAL: cannot inspect pending recovery'
        [ -n "$pending_entry" ] || return 0
    fi
    acquire_lock
    if [ -n "$1" ]; then recover_selected_group "$1"; return; fi
    recovery_failed=0
    for state_path in "$PENDING_DIR"/* "$PENDING_DIR"/.[!.]* "$PENDING_DIR"/..?*; do
        [ -e "$state_path" ] || [ -L "$state_path" ] || continue
        recover_state || recovery_failed=1
    done
    return "$recovery_failed"
}

run_maintenance() {
    dry_run=${1:-false}
    include_prune=${2:-true}
    check_common_config
    check_maintenance_config
    if ! is_true "$PW_BACKUP_RETENTION_ENABLED"; then
        log 'retention is disabled'
        return 0
    fi

    set -- forget --group-by host,paths,tags
    [ -z "$PW_BACKUP_HOST" ] || set -- "$@" --host "$PW_BACKUP_HOST"
    [ -z "$PW_BACKUP_TAG" ] || set -- "$@" --tag "$PW_BACKUP_TAG"
    [ -z "$PW_BACKUP_KEEP_LAST" ] || set -- "$@" --keep-last "$PW_BACKUP_KEEP_LAST"
    [ -z "$PW_BACKUP_KEEP_HOURLY" ] || set -- "$@" --keep-hourly "$PW_BACKUP_KEEP_HOURLY"
    [ -z "$PW_BACKUP_KEEP_DAILY" ] || set -- "$@" --keep-daily "$PW_BACKUP_KEEP_DAILY"
    [ -z "$PW_BACKUP_KEEP_WEEKLY" ] || set -- "$@" --keep-weekly "$PW_BACKUP_KEEP_WEEKLY"
    [ -z "$PW_BACKUP_KEEP_MONTHLY" ] || set -- "$@" --keep-monthly "$PW_BACKUP_KEEP_MONTHLY"
    [ -z "$PW_BACKUP_KEEP_YEARLY" ] || set -- "$@" --keep-yearly "$PW_BACKUP_KEEP_YEARLY"
    if is_true "$PW_BACKUP_PRUNE" && is_true "$include_prune"; then set -- "$@" --prune; fi
    if is_true "$dry_run"; then
        set -- "$@" --dry-run
        log 'previewing Restic maintenance policy'
    else
        log 'applying Restic maintenance policy'
    fi
    if [ -n "$email_to" ]; then run_notified_restic "$@"; fi
    exec restic "$@"
}

configured_groups() {
    for group_dir in "$CONFIG_ROOT"/groups/* "$CONFIG_ROOT"/groups/.[!.]* "$CONFIG_ROOT"/groups/..?*; do
        [ -d "$group_dir" ] || continue
        group_name=${group_dir##*/}
        validate_group "$group_name"
        printf '%s\n' "$group_name"
    done
}

check_legacy_group_safety() {
    # With groups present, an unfiltered legacy policy could select their
    # snapshots. The generated tag namespace belongs exclusively to groups.
    case "$PW_BACKUP_HOST" in
        *[![:space:]]*) ;;
        *) fail 'legacy retention requires an explicit PW_BACKUP_HOST when groups exist' ;;
    esac
    case "$PW_BACKUP_TAG" in
        ''|*,*|pw-backup-group-*) fail 'legacy retention requires a single, non-group PW_BACKUP_TAG when groups exist' ;;
    esac
}

run_all_maintenance() {
    groups=$(configured_groups)
    if [ -z "$groups" ]; then
        prepare_email maintenance
        load_config
        run_maintenance "$1"
        return
    fi

    # Validate every scope before the first forget, including disabled groups.
    # Only the small, in-memory list of exact repository strings is shared.
    prune_repositories='
'
    for scope in '' $groups; do
        prune_repository=$(
            prepare_email maintenance
            load_config "$scope"
            if [ -n "$scope" ]; then
                check_backup_config
            else
                check_maintenance_config
                if is_true "$PW_BACKUP_RETENTION_ENABLED"; then
                    check_common_config
                    check_legacy_group_safety
                fi
            fi
            if is_true "$PW_BACKUP_PRUNE"; then printf '%s' "${RESTIC_REPOSITORY:-}"; fi
        ) || return 1
        if [ -n "$prune_repository" ]; then
            case "$prune_repositories" in
                *"
$prune_repository
"*) fail 'multiple prune owners declare the same RESTIC_REPOSITORY' ;;
            esac
            prune_repositories="$prune_repositories$prune_repository
"
        fi
    done

    # Each subprocess starts from the caller's environment, never a previously
    # loaded legacy/group configuration. The parent keeps the one lock held.
    for scope in '' $groups; do
        (
            prepare_email maintenance
            load_config "$scope"
            if is_true "$PW_BACKUP_RETENTION_ENABLED"; then
                [ -n "$scope" ] || check_legacy_group_safety
                run_maintenance "$1" false
            else
                log "retention is disabled for ${scope:-legacy}"
            fi
        )
    done

    # Reclaim shared repository data only after all forget policies succeed.
    for scope in '' $groups; do
        (
            prepare_email prune
            load_config "$scope"
            if is_true "$PW_BACKUP_RETENTION_ENABLED" && is_true "$PW_BACKUP_PRUNE"; then
                if is_true "$1"; then set -- prune --dry-run; else set -- prune; fi
                log "pruning repository for ${scope:-legacy}"
                if [ -n "$email_to" ]; then run_notified_restic "$@"; fi
                exec restic "$@"
            fi
        )
    done
}

command=${1:-run}
case "$command" in
    run|check-config)
        [ "$#" -gt 0 ] || fail "usage: pw-backup $command [--group <name>]"
        shift
        selected_group=''
        if [ "$#" -ne 0 ]; then
            [ "$#" -eq 2 ] || fail "usage: pw-backup $command [--group <name>]"
            [ "$1" = --group ] || fail "usage: pw-backup $command [--group <name>]"
            validate_group "$2"
            selected_group=$2
        fi
        if [ "$command" = run ]; then prepare_email backup; acquire_lock; fi
        load_config "$selected_group"
        if [ "$command" = run ]; then
            run_backup
        else
            check_backup_config
            log 'configuration is valid'
        fi
        ;;
    maintenance|retention)
        shift
        case "${1:-}" in
            '') dry_run=false ;;
            --dry-run) dry_run=true; shift ;;
            *) fail 'usage: pw-backup maintenance [--dry-run]' ;;
        esac
        [ "$#" -eq 0 ] || fail 'usage: pw-backup maintenance [--dry-run]'
        prepare_email maintenance
        acquire_lock
        run_all_maintenance "$dry_run"
        ;;
    restic)
        shift
        selected_group=''
        if [ "${1:-}" = --group ]; then
            [ "$#" -ge 2 ] || fail 'usage: pw-backup restic [--group <name>] <arguments...>'
            validate_group "$2"
            selected_group=$2
            shift 2
        fi
        [ "$#" -gt 0 ] || fail 'missing Restic arguments'
        acquire_lock
        load_config "$selected_group"
        check_common_config
        exec restic "$@"
        ;;
    recover)
        shift
        selected_group=''
        if [ "$#" -ne 0 ]; then
            [ "$#" -eq 2 ] || fail 'usage: pw-backup recover [--group <name>]'
            [ "$1" = --group ] || fail 'usage: pw-backup recover [--group <name>]'
            validate_group "$2"
            selected_group=$2
        fi
        prepare_email recovery
        run_recover "$selected_group"
        ;;
    --version|-V|version) printf '%s %s\n' "$PROGRAM_NAME" "$PROGRAM_VERSION" ;;
    --help|-h|help) show_help ;;
    *) fail "unknown command: $command" ;;
esac
