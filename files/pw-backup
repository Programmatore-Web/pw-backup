#!/bin/sh
set -eu

PROGRAM_NAME='pw-backup'
PROGRAM_VERSION='0.2.0'
DEFAULT_CONFIG_DIR='/etc/pw-backup'

log() { printf '%s: %s\n' "$PROGRAM_NAME" "$*"; }
fail() { printf '%s: error: %s\n' "$PROGRAM_NAME" "$*" >&2; exit 1; }

show_help() {
    cat <<'HELP'
Usage:
  pw-backup run
  pw-backup maintenance [--dry-run]
  pw-backup check-config
  pw-backup restic <arguments...>
  pw-backup --version
  pw-backup --help

Commands:
  run          Run only the configured Restic backup.
  maintenance  Apply configured retention and optional prune.
  check-config Validate backup and maintenance configuration.
  restic       Run Restic with the configured repository environment.
HELP
}

is_true() {
    case "$1" in
        1|true|TRUE|yes|YES|on|ON) return 0 ;;
        0|false|FALSE|no|NO|off|OFF) return 1 ;;
        *) fail "invalid boolean value: $1" ;;
    esac
}

validate_optional_count() {
    name=$1
    value=$2
    case "$value" in
        '') return 0 ;;
        *[!0-9]*) fail "$name must be empty or a non-negative integer" ;;
    esac
}

load_config() {
    CONFIG_DIR=${PW_BACKUP_CONFIG_DIR:-$DEFAULT_CONFIG_DIR}
    CONFIG_FILE=${PW_BACKUP_CONFIG_FILE:-$CONFIG_DIR/config.env}
    PATHS_FILE=${PW_BACKUP_PATHS_FILE:-$CONFIG_DIR/paths}
    EXCLUDES_FILE=${PW_BACKUP_EXCLUDES_FILE:-$CONFIG_DIR/excludes}

    [ -r "$CONFIG_FILE" ] || fail "configuration file is not readable: $CONFIG_FILE"
    [ "$(stat -c '%u' "$CONFIG_FILE")" = '0' ] || fail "configuration file must be owned by root: $CONFIG_FILE"
    if find "$CONFIG_FILE" -perm /022 -print -quit | grep -q .; then
        fail "configuration file must not be writable by group or others: $CONFIG_FILE"
    fi

    # shellcheck source=/dev/null
    . "$CONFIG_FILE"

    : "${RESTIC_PASSWORD_FILE:=$CONFIG_DIR/repository-password}"
    : "${RESTIC_CACHE_DIR:=/var/cache/pw-backup/restic}"
    : "${PW_BACKUP_TAG:=pw-backup}"
    : "${PW_BACKUP_HOST:=}"
    : "${PW_BACKUP_SKIP_IF_UNCHANGED:=true}"
    : "${PW_BACKUP_RETENTION_ENABLED:=false}"
    : "${PW_BACKUP_KEEP_LAST:=}"
    : "${PW_BACKUP_KEEP_HOURLY:=}"
    : "${PW_BACKUP_KEEP_DAILY:=}"
    : "${PW_BACKUP_KEEP_WEEKLY:=}"
    : "${PW_BACKUP_KEEP_MONTHLY:=}"
    : "${PW_BACKUP_KEEP_YEARLY:=}"
    : "${PW_BACKUP_PRUNE:=false}"

    export RESTIC_REPOSITORY RESTIC_PASSWORD_FILE RESTIC_CACHE_DIR
}

check_common_config() {
    command -v restic >/dev/null 2>&1 || fail 'Restic is not installed'
    [ -n "${RESTIC_REPOSITORY:-}" ] || fail 'RESTIC_REPOSITORY is empty'
    [ -r "$RESTIC_PASSWORD_FILE" ] || fail "password file is not readable: $RESTIC_PASSWORD_FILE"
    [ -s "$RESTIC_PASSWORD_FILE" ] || fail "password file is empty: $RESTIC_PASSWORD_FILE"
    mkdir -p "$RESTIC_CACHE_DIR"
    chmod 0700 "$RESTIC_CACHE_DIR"
}

check_maintenance_config() {
    is_true "$PW_BACKUP_RETENTION_ENABLED" >/dev/null || true
    is_true "$PW_BACKUP_PRUNE" >/dev/null || true
    validate_optional_count PW_BACKUP_KEEP_LAST "$PW_BACKUP_KEEP_LAST"
    validate_optional_count PW_BACKUP_KEEP_HOURLY "$PW_BACKUP_KEEP_HOURLY"
    validate_optional_count PW_BACKUP_KEEP_DAILY "$PW_BACKUP_KEEP_DAILY"
    validate_optional_count PW_BACKUP_KEEP_WEEKLY "$PW_BACKUP_KEEP_WEEKLY"
    validate_optional_count PW_BACKUP_KEEP_MONTHLY "$PW_BACKUP_KEEP_MONTHLY"
    validate_optional_count PW_BACKUP_KEEP_YEARLY "$PW_BACKUP_KEEP_YEARLY"
    if is_true "$PW_BACKUP_RETENTION_ENABLED" &&
       [ -z "$PW_BACKUP_KEEP_LAST$PW_BACKUP_KEEP_HOURLY$PW_BACKUP_KEEP_DAILY$PW_BACKUP_KEEP_WEEKLY$PW_BACKUP_KEEP_MONTHLY$PW_BACKUP_KEEP_YEARLY" ]; then
        fail 'retention is enabled but no keep policy is configured'
    fi
}

check_backup_config() {
    check_common_config
    check_maintenance_config
    [ -r "$PATHS_FILE" ] || fail "paths file is not readable: $PATHS_FILE"
    grep -Eq '^[[:space:]]*[^#[:space:]]' "$PATHS_FILE" || fail "paths file does not contain any active source: $PATHS_FILE"
    if [ -e "$EXCLUDES_FILE" ] && [ ! -r "$EXCLUDES_FILE" ]; then
        fail "excludes file is not readable: $EXCLUDES_FILE"
    fi
    is_true "$PW_BACKUP_SKIP_IF_UNCHANGED" >/dev/null || true
}

run_backup() {
    check_backup_config
    set -- backup --files-from "$PATHS_FILE"
    [ ! -r "$EXCLUDES_FILE" ] || set -- "$@" --exclude-file "$EXCLUDES_FILE"
    [ -z "$PW_BACKUP_TAG" ] || set -- "$@" --tag "$PW_BACKUP_TAG"
    [ -z "$PW_BACKUP_HOST" ] || set -- "$@" --host "$PW_BACKUP_HOST"
    if is_true "$PW_BACKUP_SKIP_IF_UNCHANGED"; then set -- "$@" --skip-if-unchanged; fi
    log 'starting Restic backup'
    exec restic "$@"
}

run_maintenance() {
    dry_run=${1:-false}
    check_common_config
    check_maintenance_config
    if ! is_true "$PW_BACKUP_RETENTION_ENABLED"; then
        log 'retention is disabled'
        return 0
    fi

    set -- forget --group-by host,paths,tags
    [ -z "$PW_BACKUP_HOST" ] || set -- "$@" --host "$PW_BACKUP_HOST"
    [ -z "$PW_BACKUP_TAG" ] || set -- "$@" --tag "$PW_BACKUP_TAG"
    [ -z "$PW_BACKUP_KEEP_LAST" ] || set -- "$@" --keep-last "$PW_BACKUP_KEEP_LAST"
    [ -z "$PW_BACKUP_KEEP_HOURLY" ] || set -- "$@" --keep-hourly "$PW_BACKUP_KEEP_HOURLY"
    [ -z "$PW_BACKUP_KEEP_DAILY" ] || set -- "$@" --keep-daily "$PW_BACKUP_KEEP_DAILY"
    [ -z "$PW_BACKUP_KEEP_WEEKLY" ] || set -- "$@" --keep-weekly "$PW_BACKUP_KEEP_WEEKLY"
    [ -z "$PW_BACKUP_KEEP_MONTHLY" ] || set -- "$@" --keep-monthly "$PW_BACKUP_KEEP_MONTHLY"
    [ -z "$PW_BACKUP_KEEP_YEARLY" ] || set -- "$@" --keep-yearly "$PW_BACKUP_KEEP_YEARLY"
    if is_true "$PW_BACKUP_PRUNE"; then set -- "$@" --prune; fi
    if is_true "$dry_run"; then
        set -- "$@" --dry-run
        log 'previewing Restic maintenance policy'
    else
        log 'applying Restic maintenance policy'
    fi
    exec restic "$@"
}

command=${1:-run}
case "$command" in
    run)
        [ "$#" -eq 1 ] || fail 'run does not accept arguments'
        load_config
        run_backup
        ;;
    maintenance|retention)
        shift
        case "${1:-}" in
            '') dry_run=false ;;
            --dry-run) dry_run=true; shift ;;
            *) fail 'usage: pw-backup maintenance [--dry-run]' ;;
        esac
        [ "$#" -eq 0 ] || fail 'usage: pw-backup maintenance [--dry-run]'
        load_config
        run_maintenance "$dry_run"
        ;;
    check-config)
        [ "$#" -eq 1 ] || fail 'check-config does not accept arguments'
        load_config
        check_backup_config
        log 'configuration is valid'
        ;;
    restic)
        shift
        [ "$#" -gt 0 ] || fail 'missing Restic arguments'
        load_config
        check_common_config
        exec restic "$@"
        ;;
    --version|-V|version) printf '%s %s\n' "$PROGRAM_NAME" "$PROGRAM_VERSION" ;;
    --help|-h|help) show_help ;;
    *) fail "unknown command: $command" ;;
esac
